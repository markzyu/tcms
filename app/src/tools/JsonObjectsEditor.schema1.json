{
  "schemaVersion": "0.1.0",
  "editorUiSchema": {
    "fieldGroups": [
      {
        "labelByLanguage": {
          "en": "Basic Information",
          "ja": "基本情報"
        },
        "fields": [
          {
            "path": "name"
          },
          {
            "path": "headline"
          },
          {
            "type": "textarea",
            "path": "bio"
          }
        ],
        "isSingleton": true
      },
      {
        "labelByLanguage": {
          "en": "Contact Information",
          "ja": "連絡先"
        },
        "fields": [
          {
            "type": "input",
            "inputType": "email",
            "path": "email"
          },
          {
            "type": "input",
            "inputType": "tel",
            "path": "phone"
          }
        ],
        "isSingleton": true
      },
      {
        "fields": [
          {
            "type": "media",
            "path": "heroImage"
          }
        ],
        "isSingleton": true,
        "isSingleField": true
      },
      {
        "labelByLanguage": {
          "en": "Example Deep Field",
          "ja": "例深いフィールド"
        },
        "fields": [
          {
            "type": "input",
            "inputType": "password",
            "path": "exampleDeepField.field1"
          }
        ],
        "isSingleton": true
      }
    ],
    "fieldLabels": {
      "en": {
        "name": "Name",
        "headline": "Headline",
        "bio": "Bio",
        "email": "Email",
        "phone": "Phone",
        "heroImage": "Hero Image",
        "heroAltText": "Hero Alt Text",
        "heroAlignment": "Hero Alignment",
        "exampleDeepField": "Example Deep Field",
        "exampleDeepField.field1": "Question 1",
        "exampleDeepField.field2": "Question 2",
        "exampleDeepField.field3": "Question 3",
        "projects.{index}": "Project {index}",
        "projects.{index}.title": "Title",
        "projects.{index}.description": "Description",
        "projects.{index}.url": "URL",
        "projects.{index}.tasks": "Tasks"
      },
      "ja": {
        "name": "名前",
        "headline": "職業",
        "bio": "自己紹介",
        "email": "メールアドレス",
        "phone": "電話番号",
        "heroImage": "写真",
        "heroAltText": "写真の代替テキスト",
        "heroAlignment": "写真の配置",
        "exampleDeepField": "例深いフィールド",
        "exampleDeepField.field1": "質問 1",
        "exampleDeepField.field2": "質問 2",
        "exampleDeepField.field3": "質問 3",
        "projects.{index}": "項目 {index}",
        "projects.{index}.title": "タイトル",
        "projects.{index}.description": "説明",
        "projects.{index}.url": "URL",
        "projects.{index}.tasks": "タスク"
      }
    }
  },
  "jsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "headline": {
        "type": "string"
      },
      "bio": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "phone": {
        "type": "string"
      },
      "heroImage": {
        "type": "string"
      },
      "heroAltText": {
        "type": "string"
      },
      "heroAlignment": {
        "default": "left",
        "type": "string",
        "enum": [
          "left",
          "right"
        ]
      },
      "exampleDeepField": {
        "type": "object",
        "properties": {
          "field1": {
            "type": "string"
          },
          "field2": {
            "type": "number"
          },
          "field3": {
            "type": "boolean"
          }
        }
      },
      "projects": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "url": { "type": "string" },
            "tasks": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "required": [
      "name",
      "heroImage"
    ],
    "additionalProperties": false
  }
}