{
  "name": "@tcms/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lcdn": "CARGO_TARGET_DIR=src-tauri/target/from-yarn cargo run --bin lcdn-standalone",
    "android:build-arm64": "yarn android:sync-assets && tauri android build -d --target aarch64 && bash scripts/test-android-apk-assumptions.sh src-tauri/gen/android/app/build/outputs/apk/universal/debug/app-universal-debug.apk",
    "android:release-arm64": "yarn android:sync-assets && tauri android build --target aarch64 && bash scripts/test-android-apk-assumptions.sh src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release-unsigned.apk",
    "android:sync-assets": "rsync -av public/ src-tauri/gen/android/app/src/main/assets/prefabs/",
    "android:test-apk": "bash scripts/test-android-apk-assumptions.sh",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "sync-assets": "rsync -av public/ src-tauri/target/debug/prefabs/",
    "test": "vitest run && CARGO_TARGET_DIR=src-tauri/target/from-yarn cargo test && echo '[cargo fmt] Running lint checks ...' && cargo fmt --check --all",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit && echo '[@tcms/app] typecheck passed.'"
  },
  "dependencies": {
    "@ionic/vue": "^8.8.13",
    "@ionic/vue-router": "^8.8.13",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "~2",
    "@tcms/mini-app-common": "workspace:^",
    "intl-messageformat": "^11.2.12",
    "lodash": "^4.18.1",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3",
    "zod-from-json-schema": "^0.5.6"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "^10.5.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/compiler-dom": "^3.5.39",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.5.1",
    "tailwindcss": "3",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
