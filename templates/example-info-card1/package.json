{
  "name": "@tcms/template-example-info-card1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/main.css -o ./dist/app.css --minify",
    "build:js": "tsx esbuild.config.mts",
    "build:schemas": "tsx src/content/rootManifest.mts",
    "build:zip": "zip -rv $PROJECT_CWD/app/public/templates/$npm_package_name.zip index.html dist",
    "build": "yarn build:schemas && yarn build:css && yarn build:js && yarn build:zip",
    "dev:css": "tailwindcss -i ./src/main.css -o ./dist/app.css --watch",
    "dev:js": "tsx esbuild.config.mts --watch",
    "dev": "run-p dev:css dev:js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@tcms/mini-app-react-utils": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.7",
    "@tcms/mini-app-react-test-utils": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.7",
    "ts-jest": "^29.2.5",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}
