{
  "name": "@pcms/template-mvp1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/main.css -o ./dist/app.css --minify",
    "build:js": "node esbuild.config.mjs",
    "build:manifests": "yarn workspace @pcms/mini-app-build-utils pcms-create-manifests --template-dir \"$(pwd)\" --config ./src/content/contactCard.ts --out ./dist",
    "build:pack": "yarn workspace @pcms/mini-app-build-utils pcms-create-template-pack --template-dir \"$(pwd)\" --dist ./dist --out ./dist/contact-card-template.zip",
    "build": "yarn build:css && yarn build:js && yarn build:manifests && yarn build:pack",
    "dev:css": "tailwindcss -i ./src/main.css -o ./dist/app.css --watch",
    "dev:js": "node esbuild.config.mjs --watch",
    "dev": "run-p dev:css dev:js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@pcms/mini-app-build-utils": "workspace:*",
    "@pcms/mini-app-common": "workspace:*",
    "@pcms/mini-app-react-test-utils": "workspace:*",
    "@pcms/mini-app-react-utils": "workspace:*",
    "@tailwindcss/cli": "^4.1.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.7",
    "ts-jest": "^29.2.5",
    "typescript": "~6.0.3",
    "zod": "^4.0.0"
  }
}
